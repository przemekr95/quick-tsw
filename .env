# Publiczny adres serwisu bez końcowego "/" (np. https://siatkowka.tswisla.pl).
# Trafia do meta tagów Open Graph w index.html (og:image musi być adresem bezwzględnym).
# Bez niego build pomija canonical, og:url i sitemap.xml (i ostrzega), a og:image jest względny.
# Nadpisz w .env.local lub w zmiennych środowiska builda.
VITE_SITE_URL=https://siatkowka.tswisla.pl
